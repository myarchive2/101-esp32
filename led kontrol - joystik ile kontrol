from machine import ADC, Pin
import time

# LDR'nin bağlı olduğu pin (ör: GPIO34)
ldr = ADC(Pin(34))

# ADC ayarları
ldr.atten(ADC.ATTN_11DB)      # 0 - 3.3V arası ölçüm
ldr.width(ADC.WIDTH_12BIT)   # 0 - 4095 arası değer

while True:
    deger = ldr.read()
    print("LDR değeri:", deger)
    time.sleep(0.1)

