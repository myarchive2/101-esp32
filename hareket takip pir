    try:
        # İsteği oku — tarayıcı bazen birden fazla pakette gönderir
        raw = b""
        conn.settimeout(5)
        while True:
            try:
                chunk = conn.recv(256)
                if not chunk:
                    break
                raw += chunk
                # HTTP header sonu: çift CRLF
                if b"\r\n\r\n" in raw:
                    break
            except OSError:
                break

        if not raw:
            return

        first_line = raw.decode("utf-8", "ignore").split("\r\n")[0]
        parts = first_line.split(" ")
        if len(parts) < 2:
