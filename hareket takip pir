"""
ESP32 MicroPython - Hareket Sensörü Gerçek Zamanlı İzleme
==========================================================
Donanım:
  - PIR Hareket Sensörü (HC-SR501 veya muadili)
    VCC  → 3.3V (veya 5V, sensöre göre)
    GND  → GND
    OUT  → GPIO 2

Kurulum:
  1. Bu dosyayı Thonny veya ampy ile ESP32'ye "main.py" olarak yükleyin.
  2. index.html dosyasını da ESP32'ye yükleyin (ampy put index.html).
  3. WIFI_SSID ve WIFI_PASSWORD değerlerini kendi ağınıza göre düzenleyin.
  4. ESP32'yi yeniden başlatın; Serial Monitor'dan IP adresini öğrenin.
  5. Tarayıcıdan http://<ESP32_IP>/ adresini açın.
"""

import network
import socket
import time
import json
import gc
from machine import Pin

# ─────────────────────────────────────────────
# AYARLAR — Kendi değerlerinizle değiştirin
# ─────────────────────────────────────────────
WIFI_SSID     = "ağ ismi"
WIFI_PASSWORD = "ağ şifresi"

SENSOR_PIN    = 2       # PIR sensör çıkış pini
DEBOUNCE_MS   = 500      # Aynı olayın tekrar sayılması için bekleme (ms)
MAX_EVENTS    = 50       # Bellekte tutulacak en fazla olay sayısı
CHUNK_SIZE    = 512      # HTML gönderiminde parça büyüklüğü (bytes)
# ─────────────────────────────────────────────

# Durum değişkenleri
motion_state  = False
event_count   = 0
last_trigger  = 0
events_log    = []
uptime_start  = time.ticks_ms()

# ── GPIO Kurulumu ──────────────────────────────
sensor = Pin(SENSOR_PIN, Pin.IN)

def sensor_isr(pin):
    global motion_state, event_count, last_trigger, events_log
    now = time.ticks_ms()
    if time.ticks_diff(now, last_trigger) < DEBOUNCE_MS:
        return
    last_trigger = now
    motion_state = bool(pin.value())
    if motion_state:
        event_count += 1
    events_log.append({"t": now, "s": 1 if motion_state else 0})
    if len(events_log) > MAX_EVENTS:
        events_log.pop(0)

sensor.irq(trigger=Pin.IRQ_RISING | Pin.IRQ_FALLING, handler=sensor_isr)

# ── Wi-Fi Bağlantısı ──────────────────────────
def connect_wifi():
    sta = network.WLAN(network.STA_IF)
    sta.active(True)
    if not sta.isconnected():
        print("Wi-Fi bağlanıyor: {}".format(WIFI_SSID))
        sta.connect(WIFI_SSID, WIFI_PASSWORD)
        for _ in range(20):
            if sta.isconnected():
                break
            time.sleep(0.5)
            print(".", end="")
        print()
    if sta.isconnected():
        ip = sta.ifconfig()[0]
        print("Bağlandı! IP: {}".format(ip))
        return ip
    else:
        raise RuntimeError("Wi-Fi bağlantısı kurulamadı!")

# ── Yardımcı Fonksiyonlar ─────────────────────
def uptime_seconds():
    return time.ticks_diff(time.ticks_ms(), uptime_start) // 1000

def build_json():
    return json.dumps({
        "motion": motion_state,
        "count":  event_count,
        "uptime": uptime_seconds(),
        "pin":    SENSOR_PIN,
        "log":    events_log[-10:]
    })


def send_all(conn, data):
    """Büyük veriyi parçalar halinde güvenli şekilde gönder."""
    if isinstance(data, str):
        data = data.encode()
    view = memoryview(data)
    total = len(data)
    sent  = 0
    while sent < total:
        chunk = view[sent:sent + CHUNK_SIZE]
        try:
            n = conn.write(chunk)
            if n is None:
                break
            sent += n
        except OSError:
            break

def send_response(conn, status, content_type, body):
    if isinstance(body, str):
        body = body.encode()
    header = (
        "HTTP/1.1 {}\r\n"
        "Content-Type: {}\r\n"
        "Content-Length: {}\r\n"
        "Connection: close\r\n"
        "Access-Control-Allow-Origin: *\r\n"
        "\r\n"
    ).format(status, content_type, len(body))
    send_all(conn, header)
    send_all(conn, body)

# ── HTTP İstek İşleyici ───────────────────────
def handle_request(conn):
