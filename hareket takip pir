# ── Ana Döngü ─────────────────────────────────
def main():
    ip = connect_wifi()
    print("\n>>> Web arayuzu: http://{}/".format(ip))
    print(">>> JSON API   : http://{}/data".format(ip))
    print(">>> Sayac sifir: http://{}/reset\n".format(ip))

    addr = socket.getaddrinfo("0.0.0.0", 80)[0][-1]
    srv  = socket.socket()
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(addr)
    srv.listen(3)      # backlog: 3 bağlantıya kadar kuyruğa al
    srv.settimeout(1)  # accept() için kısa zaman aşımı
    print("HTTP sunucusu port 80'de dinleniyor...")

    while True:
        try:
            conn, addr = srv.accept()
            handle_request(conn)
        except OSError:
            pass        # accept() zaman aşımı — normal, döngüye devam et
        gc.collect()

main()

